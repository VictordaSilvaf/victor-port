# Production site origin (no trailing slash). Required for canonical, OG and sitemap.
# On Vercel: Project Settings → Environment Variables → Production/Preview.
VITE_SITE_URL=https://victorsf.com

# Public API origin (no trailing slash). Prefer thumbnail_url / cover_url from responses.
VITE_API_URL=https://api.victorsf.com

# Cloudflare Turnstile site key (required when TURNSTILE_ENABLED=true on the API).
# VITE_TURNSTILE_SITE_KEY=

# Optional: skip Puppeteer prerender (auto-skipped on Vercel when Chrome is missing).
# SKIP_PRERENDER=1
